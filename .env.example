# Symfony API base (no trailing slash). Same path layout as mock: /api/v1/*
NEXT_PUBLIC_SYMFONY_API_URL=

# mock | false | unset
# - true: always use in-process mock catalog + mock booking (even if Symfony URL is set).
# - false: use Symfony when NEXT_PUBLIC_SYMFONY_API_URL is set (catalog + booking BFF).
# - unset: mock when Symfony URL is empty; Symfony when URL is set.
NEXT_PUBLIC_USE_MOCK_API=true

# Legacy: if "true", same as forcing mock when USE_MOCK_API is unset.
NEXT_PUBLIC_USE_TRIP_MOCKS=

# Plan-your-trip inquiry emails
INQUIRY_EMAIL_TO=codoo.puraskar@gmail.com
# INQUIRY_EMAIL_FROM=Easy Travel Nepal <noreply@easytravelnepal.com>

# SMTP (required to send inquiry emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=codoo.puraskar@gmail.com
SMTP_PASS=01110331012
# SMTP_FROM=Easy Travel Nepal <noreply@easytravelnepal.com>

# AI travel assistant (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Max chat API requests per IP per hour
AI_CHAT_RATE_LIMIT_PER_HOUR=30
