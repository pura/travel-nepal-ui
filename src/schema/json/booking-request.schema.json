{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelnepal.local/schema/booking-request.json",
  "title": "BookingRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["tripSlug", "tripId", "travelers", "startDate", "email", "fullName"],
  "properties": {
    "tripSlug": { "type": "string", "minLength": 1 },
    "tripId": { "type": "integer" },
    "travelers": { "type": "integer", "minimum": 1, "maximum": 20 },
    "startDate": { "type": "string", "format": "date" },
    "email": { "type": "string", "format": "email" },
    "fullName": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
