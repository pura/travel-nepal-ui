{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelnepal.local/schema/public-trip.json",
  "title": "PublicTrip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "durationDays",
    "tripType",
    "budgetLevel",
    "comfortLevel",
    "difficultyLevel",
    "interestTags"
  ],
  "properties": {
    "id": { "type": "integer" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "durationDays": { "type": "integer", "minimum": 1 },
    "tripType": {
      "type": "string",
      "enum": [
        "cultural_heritage",
        "trekking_hiking",
        "adventure",
        "wildlife_jungle",
        "spiritual_pilgrimage",
        "luxury_leisure",
        "family"
      ]
    },
    "budgetLevel": { "type": "string", "enum": ["budget", "mid_range", "premium"] },
    "comfortLevel": { "type": "string", "enum": ["basic", "standard", "premium"] },
    "difficultyLevel": { "type": "string", "enum": ["easy", "moderate", "challenging"] },
    "interestTags": { "type": "array", "items": { "type": "string" } },
    "priceFrom": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "string" },
            "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "NPR"] }
          }
        }
      ]
    },
    "imageUrl": { "type": ["string", "null"] },
    "startingRegion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "name"],
          "properties": {
            "slug": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "optional"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } }
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dayNumber", "title", "description"],
        "properties": {
          "dayNumber": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "details": { "type": "string" },
          "meals": { "type": "string" },
          "destinationSlug": { "type": ["string", "null"] },
          "destinationName": { "type": ["string", "null"] },
          "distanceKm": { "type": "number" },
          "altitudeMaxM": { "type": "number" },
          "altitudeMinM": { "type": "number" },
          "durationHours": { "type": "number" },
          "accommodation": { "type": "string" }
        }
      }
    },
    "totalDistanceKm": { "type": "number" },
    "altitudeMaxM": { "type": "number" },
    "altitudeMinM": { "type": "number" },
    "routeGrades": { "type": "array", "items": { "type": "string" } },
    "fitnessNotes": { "type": "array", "items": { "type": "string" } },
    "recommendedSeasons": { "type": "array", "items": { "type": "string" } },
    "mapImageUrl": { "type": ["string", "null"] },
    "galleryImageUrls": { "type": "array", "items": { "type": "string" } },
    "priceTable": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "columns", "rows"],
          "properties": {
            "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "NPR"] },
            "footnote": { "type": "string" },
            "supplementaryChargePercent": { "type": "number" },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "label"],
                "properties": {
                  "key": { "type": "string" },
                  "label": { "type": "string" }
                }
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "prices"],
                "properties": {
                  "label": { "type": "string" },
                  "prices": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "bookingFeeItems": { "type": "array", "items": { "type": "string" } },
    "gearChecklist": { "type": "array", "items": { "type": "string" } },
    "trekkingGradeNotes": { "type": ["string", "null"] },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "reviewSnippets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "location": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    },
    "sourceReferenceUrl": { "type": ["string", "null"] }
  }
}
